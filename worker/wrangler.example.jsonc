{
  // Copy to wrangler.jsonc. Only two iPhone-verified Tokyo IP:port/tcp entries.
  "name": "vpn-orbit",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "triggers": {"crons": ["*/30 * * * *"]},
  "kv_namespaces": [{"binding": "PROFILE_KV", "id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID"}],
  "vars": {
    "APPROVED_REMOTES": "119.105.93.237:1279/tcp,126.234.242.57:1281/tcp",
    "APPROVED_IDENTITY_SHA256": "SET_FROM_PREVIOUSLY_VERIFIED_IPHONE_PROFILE",
    "MAX_SERVERS": "2",
    "ALLOW_PUBLIC_CLIENT_KEYS": "false"
  },
  "secrets": {"required": ["PROFILE_ACCESS_TOKEN"]}
}
